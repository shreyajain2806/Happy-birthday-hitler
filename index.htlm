<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday ❤️</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      height: 100vh;
      overflow: hidden;
    }

    /* Login Page */
    #loginPage {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: #0a0a0a; /* Black like his shirt */
      color: white;
      padding: 20px;
      text-align: center;
    }

    #loginPage h1 {
      font-size: 28px;
      margin-bottom: 30px;
      color: #6a1b2a; /* Wine color */
    }

    #loginPage input {
      padding: 15px;
      border: 2px solid #6a1b2a;
      border-radius: 12px;
      background: #1a1a1a;
      color: white;
      font-size: 16px;
      text-align: center;
      width: 250px;
      margin-bottom: 20px;
      outline: none;
    }

    #loginPage button {
      padding: 15px 40px;
      background: #6a1b2a;
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s;
    }

    #loginPage button:active {
      transform: scale(0.95);
    }

    /* Birthday Page - "He cried" aesthetic */
    #birthdayPage {
      display: none;
      height: 100vh;
      background: #fffbf7; /* Warm white like the reel */
      color: #2d2d2d;
      padding: 20px;
      text-align: center;
      overflow-y: auto;
      position: relative;
    }

   .container {
      max-width: 400px;
      margin: 0 auto;
      padding-top: 40px;
    }

    h1 {
      font-size: 32px;
      margin-bottom: 10px;
      color: #2d2d2d;
      font-weight: 700;
    }

   .subtitle {
      font-size: 18px;
      color: #6a1b2a;
      margin-bottom: 20px;
      font-weight: 500;
    }

   .box-img {
      width: 150px;
      margin: 20px auto;
      display: block;
    }

   .instruction {
      color: #ff6b9d;
      font-size: 18px;
      margin: 30px 0 20px 0;
      font-weight: 600;
    }

    /* Interactive Hearts */
   .balloons {
      display: flex;
      gap: 20px;
      justify-content: center;
      margin: 30px 0;
      flex-wrap: wrap;
    }

   .balloon {
      font-size: 50px;
      cursor: pointer;
      animation: bounce 2s ease-in-out infinite;
      transition: transform 0.2s;
      user-select: none;
    }

   .balloon:hover {
      transform: scale(1.3);
    }

   .balloon:active {
      transform: scale(0.9);
    }

   .b1 { animation-delay: 0s; }
   .b2 { animation-delay: 0.3s; }
   .b3 { animation-delay: 0.6s; }
   .b4 { animation-delay: 0.9s; }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }

    /* Floating cute elements */
   .float-cute {
      position: fixed;
      pointer-events: none;
      font-size: 22px;
      animation: float 6s ease-in-out infinite;
      opacity: 0.4;
      z-index: 0;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(10deg); }
    }

    /* Gift popup */
   .popup {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      z-index: 1000;
      text-align: center;
      max-width: 300px;
      transition: transform 0.3s ease;
    }

   .popup.active {
      transform: translate(-50%, -50%) scale(1);
    }

   .popup h3 {
      color: #6a1b2a;
      font-size: 24px;
      margin-bottom: 15px;
    }

   .popup p {
      color: #2d2d2d;
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 20px;
    }

   .popup button {
      padding: 10px 30px;
      background: #6a1b2a;
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
    }

   .overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }

   .overlay.active {
      display: block;
    }

   .footer-text {
      margin-top: 40px;
      font-size: 14px;
      color: #888;
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <!-- Login Page -->
  <div id="loginPage">
    <h1>Enter Password</h1>
    <input type="password" id="passwordInput" placeholder="Your birthday date">
    <button onclick="checkPassword()">Unlock ❤️</button>
  </div>

  <!-- Birthday Page -->
  <div id="birthdayPage">
    <!-- Floating cute elements -->
    <div class="float-cute" style="top:10%;left:5%;animation-delay:0s;">💕</div>
    <div class="float-cute" style="top:15%;right:8%;animation-delay:1s;">🐰</div>
    <div class="float-cute" style="top:60%;left:3%;animation-delay:2s;">🐻</div>
    <div class="float-cute" style="top:85%;right:5%;animation-delay:3s;">✨</div>
    <div class="float-cute" style="top:40%;right:12%;animation-delay:4s;">💖</div>
    <div class="float-cute" style="top:75%;left:10%;animation-delay:5s;">🌸</div>

    <div class="container">
      <h1>Happy Birthday</h1>
      <p class="subtitle">to my favorite human 🎂</p>

      <!-- Cute box illustration like the reel -->
      <img src="https://i.imgur.com/8Qf8YtL.png" class="box-img" alt="cute box with animals">

      <p class="instruction">click on the hearts to see your gifts 💝</p>

      <div class="balloons">
        <div class="balloon b1" onclick="showGift(1)">💖</div>
        <div class="balloon b2" onclick="showGift(2)">💕</div>
        <div class="balloon b3" onclick="showGift(3)">💗</div>
        <div class="balloon b4" onclick="showGift(4)">💓</div>
      </div>

      <p class="footer-text">
        I know you wear black, white, and wine shirts...<br>
        So I made this in *your* colors 🤍🖤🍷<br><br>
        Made with love by your gf
      </p>
    </div>
  </div>

  <!-- Popup for gifts -->
  <div class="overlay" id="overlay" onclick="closeGift()"></div>
  <div class="popup" id="popup">
    <h3 id="giftTitle">Gift 🎁</h3>
    <p id="giftText">Your gift description</p>
    <button onclick="closeGift()">Close</button>
  </div>

  <script>
    // Change this password to his birthday
    const correctPassword = "0101"; // Example: 01 Jan = 0101

    const gifts = {
      1: {
        title: "Gift #1 🎁",
        text: "A brand new black shirt, because you look insane in black. Wearing it on our next date is mandatory 😘"
      },
      2: {
        title: "Gift #2 🍝",
        text: "Dinner at that wine place you love. I'll wear wine red to match you. It's a date ❤️"
      },
      3: {
        title: "Gift #3 📝",
        text: "100 reasons why I'm obsessed with you. Hint: Reason #1 is how you look in a white shirt"
      },
      4: {
        title: "Gift #4 🎥",
        text: "I made you a secret video message. But you only get it if you promise to not cry... okay maybe cry a little 🥺"
      }
    };

    function checkPassword() {
      const input = document.getElementById('passwordInput').value;
      if (input === correctPassword) {
        document.getElementById('loginPage').style.display = 'none';
        document.getElementById('birthdayPage').style.display = 'block';
      } else {
        alert('Wrong password babe 😭 Try again!');
        document.getElementById('passwordInput').value = '';
      }
    }

    function showGift(num) {
      document.getElementById('giftTitle').innerText = gifts[num].title;
      document.getElementById('giftText').innerText = gifts[num].text;
      document.getElementById('popup').classList.add('active');
      document.getElementById('overlay').classList.add('active');
    }

    function closeGift() {
      document.getElementById('popup').classList.remove('active');
      document.getElementById('overlay').classList.remove('active');
    }

    // Enter key support for password
    document.getElementById('passwordInput').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') checkPassword();
    });
  </script>

</body>
</html>
